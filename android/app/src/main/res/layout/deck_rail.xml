<?xml version="1.0" encoding="utf-8"?>
<!-- Deck rail (Link Line): opaque edge-docked panel, inflated by DeckOverlayView -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ds_rail_bg"
    android:clickable="true"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.droidscreen.app.ui.LinkMarkView
                android:id="@+id/deck_mark"
                android:layout_width="30dp"
                android:layout_height="15dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/instrument_sans_semibold"
                android:text="Deck"
                android:textColor="@color/ds_text"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/deck_stats_chip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/ds_chip_bg"
                android:clickable="true"
                android:contentDescription="Show detailed stats"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/ds_live_dot" />

                <TextView
                    android:id="@+id/deck_stats_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/ibm_plex_mono_regular"
                    android:includeFontPadding="false"
                    android:text="-- ms · -- fps ·"
                    android:textColor="@color/ds_text"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/deck_stats_transport_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ph_wifi_high"
                    android:tint="@color/ds_cable" />

                <TextView
                    android:id="@+id/deck_stats_transport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/ibm_plex_mono_regular"
                    android:includeFontPadding="false"
                    android:text="Wi-Fi"
                    android:textColor="@color/ds_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/deck_apps_label"
            style="@style/DsDeckSectionLabel"
            android:layout_marginTop="18dp"
            android:text="Apps" />

        <LinearLayout
            android:id="@+id/deck_apps_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/deck_media_label"
            style="@style/DsDeckSectionLabel"
            android:layout_marginTop="18dp"
            android:text="Now playing" />

        <FrameLayout
            android:id="@+id/deck_media_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/deck_volume_label"
            style="@style/DsDeckSectionLabel"
            android:layout_marginTop="18dp"
            android:text="Volume" />

        <FrameLayout
            android:id="@+id/deck_volume_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ds_line" />

        <LinearLayout
            style="@style/DsDeckControlRow"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/DsDeckControlLabel"
                android:text="Finger" />

            <com.droidscreen.app.deck.SegmentedControlView
                android:id="@+id/deck_finger_mode"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            style="@style/DsDeckControlRow"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/DsDeckControlLabel"
                android:text="Stylus" />

            <com.droidscreen.app.deck.SegmentedControlView
                android:id="@+id/deck_stylus_mode"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            style="@style/DsDeckControlRow"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/DsDeckControlLabel"
                android:text="Other" />

            <com.droidscreen.app.deck.SegmentedControlView
                android:id="@+id/deck_unknown_mode"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            style="@style/DsDeckControlRow"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/DsDeckControlLabel"
                android:text="Keys" />

            <com.droidscreen.app.deck.SegmentedControlView
                android:id="@+id/deck_keys_mode"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/deck_lock"
                style="@style/DsDeckButton"
                android:layout_marginEnd="8dp"
                android:contentDescription="Lock">

                <ImageView
                    android:id="@+id/deck_lock_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ph_lock_simple"
                    android:tint="@color/ds_text" />

                <TextView
                    android:id="@+id/deck_lock_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/instrument_sans_medium"
                    android:text="Lock"
                    android:textColor="@color/ds_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/deck_hide"
                style="@style/DsDeckButton"
                android:contentDescription="Hide">

                <ImageView
                    android:id="@+id/deck_hide_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ph_eye_slash"
                    android:tint="@color/ds_text" />

                <TextView
                    android:id="@+id/deck_hide_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/instrument_sans_medium"
                    android:text="Hide"
                    android:textColor="@color/ds_text"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
