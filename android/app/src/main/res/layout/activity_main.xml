<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_ink"
    android:clipChildren="false"
    android:clipToPadding="false">

    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Deck rail overlay (DeckOverlayView), docked to the left edge -->
    <FrameLayout
        android:id="@+id/deck_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- In-stream Link Line edge: 4dp cable line + handle tab -->
    <com.droidscreen.app.deck.DeckEdgeView
        android:id="@+id/deck_edge"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:contentDescription="Show Deck"
        android:visibility="gone" />

    <!-- Detailed stats, toggled from the Deck's stats chip -->
    <LinearLayout
        android:id="@+id/stats_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/ds_panel_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/stats_bitrate"
            style="@style/DsStatsLine"
            android:text="Bitrate: --" />

        <TextView
            android:id="@+id/stats_fps"
            style="@style/DsStatsLine"
            android:layout_marginTop="4dp"
            android:text="FPS: --" />

        <TextView
            android:id="@+id/stats_pacing"
            style="@style/DsStatsLine"
            android:layout_marginTop="4dp"
            android:text="Pacing: --" />

        <TextView
            android:id="@+id/stats_stability"
            style="@style/DsStatsLine"
            android:layout_marginTop="4dp"
            android:text="Stability: --" />

    </LinearLayout>

    <!-- Waiting / pairing screen — shown when not streaming -->
    <FrameLayout
        android:id="@+id/status_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_ink"
        android:clickable="true">

        <LinearLayout
            android:id="@+id/status_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="96dp"
            android:paddingTop="36dp"
            android:paddingEnd="96dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.droidscreen.app.ui.LinkMarkView
                    android:id="@+id/status_mark"
                    android:layout_width="40dp"
                    android:layout_height="20dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:text="DroidScreen"
                    android:textColor="@color/ds_text"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ds_pill_outline"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/ds_dot" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/instrument_sans_regular"
                        android:text="Waiting for a Mac"
                        android:textColor="@color/ds_text_2"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:letterSpacing="0.08"
                android:text="THIS TABLET"
                android:textColor="@color/ds_text_3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/status_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_sans_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:text="This tablet"
                android:textColor="@color/ds_text"
                android:textSize="72sp" />

            <TextView
                android:id="@+id/status_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/instrument_sans_regular"
                android:text=""
                android:textColor="@color/ds_text"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/status_hint_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ph_usb"
                    android:tint="@color/ds_text_2" />

                <TextView
                    android:id="@+id/status_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/instrument_sans_regular"
                    android:text="or connect a USB cable"
                    android:textColor="@color/ds_text_2"
                    android:textSize="15sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/status_hero_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.droidscreen.app.ui.LinkHeroView
                    android:id="@+id/status_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/DsStep"
                    android:layout_marginEnd="32dp">

                    <TextView
                        style="@style/DsStepNumber"
                        android:text="1" />

                    <TextView
                        android:id="@+id/status_step_1"
                        style="@style/DsStepText"
                        android:text="Open DroidScreen on your Mac" />
                </LinearLayout>

                <LinearLayout
                    style="@style/DsStep"
                    android:layout_marginEnd="32dp">

                    <TextView
                        style="@style/DsStepNumber"
                        android:text="2" />

                    <TextView
                        android:id="@+id/status_step_2"
                        style="@style/DsStepText"
                        android:text="Choose this tablet in the menu bar" />
                </LinearLayout>

                <LinearLayout style="@style/DsStep">

                    <TextView
                        style="@style/DsStepNumber"
                        android:background="@drawable/ds_step_number_active"
                        android:text="3"
                        android:textColor="@color/ds_cable" />

                    <TextView
                        android:id="@+id/status_step_3"
                        style="@style/DsStepText"
                        android:text="Allow the connection here" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status_version"
                    style="@style/DsFooterText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="DroidScreen" />

                <TextView
                    android:id="@+id/status_transport"
                    style="@style/DsFooterText"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Approval prompt: card anchored to the middle of the hero cable -->
    <FrameLayout
        android:id="@+id/approval_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ds_scrim" />

        <LinearLayout
            android:id="@+id/approval_card"
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/ds_card_bg"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.droidscreen.app.ui.LinkMarkView
                    android:id="@+id/approval_mark"
                    android:layout_width="28dp"
                    android:layout_height="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/ibm_plex_mono_regular"
                    android:letterSpacing="0.08"
                    android:text="CONNECTION REQUEST · WI-FI"
                    android:textColor="@color/ds_text_3"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/instrument_sans_medium"
                android:text="Allow"
                android:textColor="@color/ds_text_2"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/approval_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_sans_semibold"
                android:letterSpacing="-0.01"
                android:text="“Mac”?"
                android:textColor="@color/ds_text"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/instrument_sans_regular"
                android:lineSpacingMultiplier="1.15"
                android:text="It will use this tablet as a display and receive your touch and pen input."
                android:textColor="@color/ds_text_2"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/approval_deny"
                    style="@style/DsBigButton"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/ds_btn_ghost"
                    android:text="Deny"
                    android:textColor="@color/ds_text" />

                <Button
                    android:id="@+id/approval_allow"
                    style="@style/DsBigButton"
                    android:background="@drawable/ds_btn_primary"
                    android:text="Allow"
                    android:textColor="@color/ds_ink" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/instrument_sans_regular"
                android:gravity="center"
                android:text="You won't be asked again for this Mac."
                android:textColor="@color/ds_text_3"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:id="@+id/approval_dot_start"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/ds_dot"
            android:visibility="invisible" />

        <View
            android:id="@+id/approval_dot_end"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/ds_dot"
            android:visibility="invisible" />
    </FrameLayout>

</FrameLayout>
