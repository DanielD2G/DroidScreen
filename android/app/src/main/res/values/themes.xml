<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DroidScreen" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/ds_ink</item>
        <item name="android:colorAccent">@color/ds_cable</item>
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
    </style>

    <!-- Link Line text and control styles -->
    <style name="DsDeckSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/instrument_sans_medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ds_text_3</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="DsDeckControlRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="DsDeckControlLabel">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textColor">@color/ds_text_2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DsDeckButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/ds_btn_ghost</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="DsStatsLine">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DsStep">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/ds_step_rule</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">16dp</item>
    </style>

    <style name="DsStepNumber">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/ds_step_number</item>
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DsStepText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textColor">@color/ds_text_2</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="DsFooterText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:textColor">@color/ds_text_3</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="DsBigButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">@font/instrument_sans_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
