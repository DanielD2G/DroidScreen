<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_raised" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/ds_text_3" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_ink" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/ds_cable" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_ink" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/ds_line" />
        </shape>
    </item>
</selector>
