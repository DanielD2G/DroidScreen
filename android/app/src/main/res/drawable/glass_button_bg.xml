<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#AA252836" />
            <corners android:radius="12dp" />
            <stroke android:width="0.5dp" android:color="#55FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8C151922" />
            <corners android:radius="12dp" />
            <stroke android:width="0.5dp" android:color="#38FFFFFF" />
        </shape>
    </item>
</selector>
