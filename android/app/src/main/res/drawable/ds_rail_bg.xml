<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque Deck rail: surface fill with a 1dp line on the stream-facing edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_line" />
        </shape>
    </item>
    <item android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface" />
        </shape>
    </item>
</layer-list>
