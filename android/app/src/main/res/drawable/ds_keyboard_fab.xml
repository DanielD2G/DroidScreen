<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent round button over the stream; yellow ring while the keyboard is open. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#B30F1115" />
            <stroke android:width="1.5dp" android:color="@color/ds_cable" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#CC1F232B" />
            <stroke android:width="1dp" android:color="#66F3F1EA" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#730F1115" />
            <stroke android:width="1dp" android:color="#40F3F1EA" />
        </shape>
    </item>
</selector>
