;
; DroidScreenDriver.inf
;
; IddCx Indirect Display Driver for DroidScreen
; Creates a virtual display that the desktop app captures via WGC
; and streams to an Android tablet over USB.
;
; Compatible with Windows 10 version 2004+ (IddCx 1.4+)
;

[Version]
Signature   = "$Windows NT$"
ClassGUID   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class       = Display
ClassVer    = 2.0
Provider    = %ManufacturerName%
CatalogFile = DroidScreenDriver.cat
DriverVer   = 04/05/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = DroidScreenDriver_Install, Root\DroidScreenDriver

; ---------------------------------------------------------------------------
; Device Install Section
; ---------------------------------------------------------------------------

[DroidScreenDriver_Install]
; No files to copy for UMDF — the DLL is specified in the service section

[DroidScreenDriver_Install.hw]
AddReg = DroidScreenDriver_HardwareReg

[DroidScreenDriver_HardwareReg]
; Mark this as a software device (no physical hardware)
HKR,,DeviceCharacteristics,0x10001,0x0100      ; FILE_DEVICE_SECURE_OPEN
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)"   ; Admin and System only

; ---------------------------------------------------------------------------
; Service Install
; ---------------------------------------------------------------------------

[DroidScreenDriver_Install.Services]
AddService = DroidScreenDriver,0x00000002,DroidScreenDriver_ServiceInstall

[DroidScreenDriver_ServiceInstall]
DisplayName   = %ServiceName%
ServiceType   = 1                  ; SERVICE_KERNEL_DRIVER (UMDF loaded via reflector)
StartType     = 3                  ; SERVICE_DEMAND_START
ErrorControl  = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\DroidScreenDriver.dll

; ---------------------------------------------------------------------------
; WDTF (Windows Driver Test Framework) Override — for testing
; ---------------------------------------------------------------------------

[DroidScreenDriver_Install.Wdf]
UmdfService      = DroidScreenDriver,DroidScreenDriver_UmdfServiceInstall
UmdfServiceOrder  = DroidScreenDriver
UmdfDispatcher    = IddCx
UmdfKernelModeClientPolicy = AllowKernelModeClients

[DroidScreenDriver_UmdfServiceInstall]
UmdfLibraryVersion = 2.15.0
ServiceBinary      = %13%\DroidScreenDriver.dll

; ---------------------------------------------------------------------------
; Device Interface — for IddCx
; ---------------------------------------------------------------------------

[DroidScreenDriver_Install.Interfaces]
AddInterface = %GUID_DEVINTERFACE_DISPLAY_ADAPTER%,,DroidScreenDriver_InterfaceInstall

[DroidScreenDriver_InterfaceInstall]
AddReg = DroidScreenDriver_InterfaceReg

[DroidScreenDriver_InterfaceReg]
HKR,,ReferenceString,,"DroidScreenDriver"

; ---------------------------------------------------------------------------
; Copy Files
; ---------------------------------------------------------------------------

[DestinationDirs]
DroidScreenDriver_CopyFiles = 13    ; Driver Store

[DroidScreenDriver_Install.NT]
CopyFiles = DroidScreenDriver_CopyFiles

[DroidScreenDriver_CopyFiles]
DroidScreenDriver.dll

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
DroidScreenDriver.dll = 1

; ---------------------------------------------------------------------------
; Strings
; ---------------------------------------------------------------------------

[Strings]
ManufacturerName = "DroidScreen"
DeviceName       = "DroidScreen Virtual Display"
ServiceName      = "DroidScreen Virtual Display Driver"
DiskName         = "DroidScreen Driver Installation Disk"
GUID_DEVINTERFACE_DISPLAY_ADAPTER = "{5B45201D-F2F2-4F3B-85BB-30FF1F953599}"
